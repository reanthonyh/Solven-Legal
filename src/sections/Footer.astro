---
const currentYear = new Date().getFullYear();

const navLinks = [
  { label: "Inicio", href: "/" },
  { label: "Áreas de práctica", href: "#services" },
  { label: "Nosotros", href: "#nosotros" },
  { label: "Contacto", href: "#contacto" },
];

const practiceAreas = [
  { label: "Gestión de cobranza", href: "#services" },
  { label: "Derecho civil", href: "#services" },
  { label: "Derecho comercial", href: "#services" },
  { label: "Litigios", href: "#services" },
];
---

<footer class="bg-primary text-white pt-16 pb-8 animate-fade-in">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      <div>
        <div class="flex items-center gap-3 mb-6">
          <img src="/favicon.svg" alt="Solven Legal" class="w-10 h-10" />
          <span class="font-semibold text-lg font-lora">Solven Legal</span>
        </div>
        <p class="text-white/70 text-sm leading-relaxed">
          Despacho jurídico comprometido con la recuperación de sus créditos y la protección de sus intereses legales.
        </p>
      </div>

      <div>
        <h4 class="font-semibold mb-4">Enlaces rápidos</h4>
        <ul class="space-y-3">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="text-white/70 hover:text-white text-sm transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-semibold mb-4">Áreas de práctica</h4>
        <ul class="space-y-3">
          {practiceAreas.map((area) => (
            <li>
              <a href={area.href} class="text-white/70 hover:text-white text-sm transition-colors">
                {area.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-semibold mb-4">Contacto</h4>
        <ul class="space-y-3 text-sm text-white/70">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            contacto@solvenlegal.com
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            (55) 1234-5678
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-white/50 text-sm">
        © {currentYear} Solven Legal. Todos los derechos reservados.
      </p>
      <div class="flex gap-6">
        <a href="#" class="text-white/50 hover:text-white text-sm transition-colors">Aviso de privacidad</a>
        <a href="#" class="text-white/50 hover:text-white text-sm transition-colors">Términos y condiciones</a>
      </div>
    </div>
  </div>
</footer>
