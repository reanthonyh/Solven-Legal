---
const navLinks = [
  { label: "Inicio", href: "/" },
  { label: "Servicios", href: "/servicios" },
  { label: "Nosotros", href: "/nosotros" },
  { label: "Contacto", href: "/contacto" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-primary/95 backdrop-blur-sm shadow-sm transition-all duration-300">
  <nav class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <img src="/favicon.svg" alt="Solven Legal" class="w-10 h-10" />
      <span class="text-white font-semibold text-lg font-lora"
        >Solven Legal</span
      >
    </a>

    <ul class="hidden md:flex items-center gap-8">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-white/80 hover:text-white text-sm font-medium transition-colors"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href="/contacto"
      class="hidden md:inline-flex bg-secondary hover:bg-secondary/90 text-foreground px-5 py-2.5 rounded-lg text-sm font-medium transition-colors"
    >
      Consulta gratuita
    </a>

    <button
      id="mobile-menu-toggle"
      class="md:hidden text-white p-2"
      aria-label="Abrir menú"
    >
      <svg
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </nav>
</header>

<div
  id="mobile-menu"
  class="hidden fixed inset-0 z-40 bg-primary/95 backdrop-blur-sm md:hidden"
>
  <div class="flex flex-col items-center justify-center h-full gap-8">
    {
      navLinks.map((link) => (
        <a href={link.href} class="text-white text-xl font-medium">
          {link.label}
        </a>
      ))
    }
    <a
      href="/contacto"
      class="bg-secondary text-white px-6 py-3 rounded-lg font-medium"
    >
      Consulta gratuita
    </a>
    <button id="mobile-menu-close" class="text-white/80 mt-4">Cerrar</button>
  </div>
</div>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const close = document.getElementById("mobile-menu-close");
  const menu = document.getElementById("mobile-menu");
  const header = document.querySelector('header');

  toggle?.addEventListener("click", () => menu?.classList.remove("hidden"));
  close?.addEventListener("click", () => menu?.classList.add("hidden"));

  // Add scroll effect to header
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header?.classList.add('shadow-lg');
    } else {
      header?.classList.remove('shadow-lg');
    }
  });
</script>
