---
interface Props {
  text: string;
  disabled?: boolean;
  color?: "primary" | "secondary" | "outline";
  id?: string;
}

const { text, disabled = false, color = "primary", id } = Astro.props;

const colorClasses = {
  primary: "bg-primary text-surface hover:bg-primary/90",
  secondary: "bg-secondary text-surface hover:bg-secondary/90",
  outline:
    "bg-transparent border-2 border-primary text-primary hover:bg-primary hover:text-surface",
};
---

<button
  id={id}
  class:list={[
    "px-4 py-2 rounded-lg font-inter font-medium transition-colors duration-200",
    colorClasses[color],
    disabled && "opacity-50 cursor-not-allowed",
  ]}
  disabled={disabled}
>
  {text}
</button>
